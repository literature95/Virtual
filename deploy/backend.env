# Virtual_background 运行环境变量
# 用法（Linux/macOS）：
#   set -a; source deploy/backend.env; set +a
#   dart build/bin/server.dart        # 或 ./build/bin/server（AOT）
#
# Windows（PowerShell）：
#   Get-Content deploy/backend.env | ForEach-Object {
#     if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) }
#   }

# ─────────────────────────────────────────────
# 数据库（服务器已安装的宿主 PostgreSQL）
# 凭据由用户指定：postgres / 1234
# ⚠️ 1234 为弱密码，生产环境务必改为强密码
# ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=virtual
DB_USER=postgres
DB_PASSWORD=1234

# ─────────────────────────────────────────────
# JWT（必须固定为长随机串，否则每次重启所有登录会话失效）
# 用 `openssl rand -hex 32` 生成后替换下面占位
# ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING_GENERATED_BY_OPenssl_rand_hex_32

# ─────────────────────────────────────────────
# 发布角色卡鉴权令牌（可选；对应后端 PUBLISH_TOKEN 校验）
# 不填则发布接口不要求令牌
# ─────────────────────────────────────────────
PUBLISH_TOKEN=

# ─────────────────────────────────────────────
# SMTP（不配则验证码走控制台降级打印，注册/改密流程仍可跑通）
# 配了才发真实邮件
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ─────────────────────────────────────────────
# 服务端口（Dart Frog server 读取 PORT；默认 8080）
# ─────────────────────────────────────────────
PORT=8080
